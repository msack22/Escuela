# Variables de entorno para el backend

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://root:tu_password@localhost/concursos_db

# Redis
REDIS_URL=redis://localhost:6379

# APIs Externas
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# Opción 1: Twilio (costo por mensaje)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=tu_numero_twilio_whatsapp_aqui

# Opción 2: WhatsApp Business API (GRATIS - 1000 mensajes/mes)
WHATSAPP_BUSINESS_TOKEN=your_whatsapp_business_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_RECIPIENT_NUMBER=+5493444123456

# Opción 4: WhatsApp Python (Python puro, recomendado)
WHATSAPP_PYTHON_TOKEN=your_whatsapp_python_token_here
WHATSAPP_PYTHON_NUMBER_ID=your_whatsapp_python_number_id_here

# Email Configuration

# Opción 1: Brevo (Sendinblue) - GRATIS 300 emails/día PERMANENTE (Recomendado)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_email@example.com

# Opción 2: SendGrid (GRATIS 100 emails/día, solo 2 meses de prueba)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDER_EMAIL=your_email@example.com

# Opción 3: Gmail SMTP (requiere App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here

# Opción 4: Outlook/Hotmail SMTP (GRATIS)
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SENDER_EMAIL=your_email@outlook.com
# SENDER_PASSWORD=your_outlook_password

# Seguridad
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Configuración de scraping
SCRAPING_INTERVAL_HOURS=2
MAX_CONCURRENT_SCRAPERS=5

# Ubicación del Usuario (para cálculo de distancia)
USER_LATITUDE=-34.6037
USER_LONGITUDE=-58.3816
