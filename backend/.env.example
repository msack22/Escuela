# Base de datos (misma que el backend Python)
DATABASE_URL="mysql://user:password@localhost:3306/escuela"

# API
PORT=8001
HOST=0.0.0.0

# Email (Brevo o SendGrid, igual que Python)
SENDER_EMAIL=
BREVO_API_KEY=
SENDGRID_API_KEY=

# Opcional: SMTP si no usás API
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_PASSWORD=

# Scraping (axios + cheerio por defecto; navegador si falla o contenido vacío)
SCRAPING_TIMEOUT_MS=60000
SCRAPING_ENGINE=playwright
SCRAPING_PREFER_HTTP=true
LOG_LEVEL=info
