# Variables de entorno para el backend

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://root:tu_password@localhost/concursos_db

# Redis
REDIS_URL=redis://localhost:6379

# APIs Externas
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# Opción 1: Twilio (costo por mensaje)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=tu_numero_twilio_whatsapp_aqui

# Opción 2: WhatsApp Business API (GRATIS - 1000 mensajes/mes)
WHATSAPP_BUSINESS_TOKEN=tu_token_de_whatsapp_business_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_id_de_numero_telefonico_aqui

# Opción 4: WhatsApp Python (Python puro, recomendado)
WHATSAPP_PYTHON_TOKEN=tu_token_de_whatsapp_python_aqui
WHATSAPP_PYTHON_NUMBER_ID=tu_id_de_numero_telefonico_aqui

# Seguridad
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de scraping
SCRAPING_INTERVAL_HOURS=2
MAX_CONCURRENT_SCRAPERS=5

# Ubicación del Usuario (para cálculo de distancia)
USER_LATITUDE=-34.6037
USER_LONGITUDE=-58.3816
