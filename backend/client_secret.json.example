# Google Calendar Configuration
CLIENT_SECRETS_FILE = client_secret.json

# OAuth 2.0 Configuration
SCOPES = ['https://www.googleapis.com/auth/calendar.readonly']

# Instructions for setting up Google Calendar API
# 1. Go to Google Cloud Console
# 2. Create a new project
# 3. Enable Google Calendar API
# 4. Create OAuth 2.0 credentials
# 5. Download client_secret.json and place in backend root
# 6. Run the calendar manager

# Example client_secret.json structure:
{
  "installed": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "your-project-id",
    "auth_uri": "http://localhost:8080/",
    "token_uri": "http://localhost:8080/",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": ["http://localhost:8080/"]
  }
}
